@startuml architecture
title Code Executor Sandbox - System Architecture (Docker Required)
skinparam componentStyle rectangle
skinparam defaultTextAlignment center
skinparam noteBackgroundColor #FFFFCC
skinparam noteBorderColor #999999

' ==================== EXTERNAL ====================
actor "Client\n(HTTP)" as client

' ==================== HOST SYSTEM ====================
package "Host Server" as host {

    ' -------------------- API Layer --------------------
    package "API Layer (FastAPI)" as api_layer #LightBlue {
        component "POST /execute" as api_execute
        component "GET /tasks/{id}" as api_get
        component "GET /tasks/{id}/stream" as api_stream
        component "DELETE /tasks/{id}" as api_kill
        component "GET /health" as api_health
        component "GET /info" as api_info
    }

    ' -------------------- Middleware --------------------
    package "Middleware" as middleware_layer #LightCyan {
        component "RateLimiter" as rate_limiter
        component "RateLimitMiddleware" as rate_middleware
    }

    ' -------------------- Core Layer --------------------
    package "Core Layer" as core_layer #LightGreen {
        component "SandboxExecutor" as executor
        component "DockerRunner" as docker_runner
        component "Semaphore" as semaphore
    }

    ' -------------------- Configuration --------------------
    package "Configuration" as config_pkg #Wheat {
        component "ExecutorConfig" as exec_config
        component "DockerConfig" as docker_config
        component "SecurityConfig" as sec_config
        component "RateLimitConfig" as rate_config
        component "ServerConfig" as server_config
    }

    ' -------------------- Storage --------------------
    package "Storage" as storage_layer #LightYellow {
        interface "TaskStorage" as storage_interface
        component "MemoryStorage" as memory_storage
    }

    ' -------------------- Data Models --------------------
    package "Models" as models_pkg #Lavender {
        component "Task" as task_model
        component "TaskStatus" as status_enum
    }
}

' ==================== DOCKER CONTAINER ====================
package "Docker Container (per task)" as docker_container #LightCoral {

    note as docker_security
      **Container Security**
      --network=none
      --read-only
      --cap-drop=ALL
      --memory=128m
      --pids-limit=50
      --user=nobody
      (Docker default seccomp)
    end note

    package "Python Sandbox (Layer 2)" as python_sandbox {
        component "Restricted Builtins" as restricted
        component "Module Whitelist" as whitelist
        component "Attribute Blocking" as attr_block
        component "Pattern Scanner" as pattern_scan
        component "Resource Limits" as res_limits
    }

    component "User Code" as user_code
}

' ==================== EXTERNAL RESOURCES ====================
database "Temp Script\n(/tmp/*.py)" as temp_files
cloud "Dockerfile.sandbox" as dockerfile

' ==================== RELATIONSHIPS ====================
client --> api_execute
client --> api_get
client --> api_stream
client --> api_kill

api_execute --> rate_middleware
rate_middleware --> rate_limiter
rate_middleware --> executor

executor --> docker_runner
executor --> semaphore
executor --> storage_interface

semaphore --> exec_config : max_concurrent_tasks

docker_runner --> docker_container : docker run
docker_runner --> temp_files : write script

storage_interface <|.. memory_storage
memory_storage --> task_model

python_sandbox --> user_code : exec()

' Config relations
docker_runner --> docker_config
executor --> exec_config
rate_limiter --> rate_config

' ==================== NOTES ====================
note right of docker_runner
  **DockerRunner**
  - Builds docker run command
  - Manages container lifecycle
  - Handles container kill
  - Uses Docker default seccomp
end note

note right of rate_limiter
  **Token Bucket**
  60 req/min per IP
  Burst: 10 requests
  Returns 429 + Retry-After
end note

note bottom of whitelist
  **Allowed Modules**
  math, json, datetime,
  collections, itertools,
  functools, random, re,
  string, copy, enum...
end note

note bottom of attr_block
  **Blocked Attributes**
  __class__, __bases__,
  __mro__, __subclasses__,
  __globals__, __code__...
  Prevents sandbox escape
end note

note right of pattern_scan
  **Pattern Detection**
  Scans for dangerous
  patterns before exec:
  __class__, __bases__...
end note

note bottom of memory_storage
  **In-Memory Storage**
  Fast, no persistence
  Task + Output buffers
end note

note right of semaphore
  **Concurrency Control**
  asyncio.Semaphore
  max_concurrent_tasks=10
  Prevents server overload
  Tasks wait or fail if full
end note

@enduml
