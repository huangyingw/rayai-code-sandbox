@startuml production_architecture
title Code Executor Sandbox - Production Architecture (Kubernetes)

skinparam componentStyle rectangle
skinparam defaultTextAlignment center

' ==================== EXTERNAL ====================
actor "Client" as client
cloud "Ingress Controller\n(nginx/ALB)" as lb #LightBlue

' ==================== KUBERNETES CLUSTER ====================
rectangle "Kubernetes Cluster" as k8s #Azure {

    ' ==================== API TIER ====================
    package "API Namespace" as api_ns #LightCyan {
        component "API Pod 1" as api1
        component "API Pod 2" as api2
        component "API Pod N" as api3
        note bottom of api1
          ServiceAccount with
          RBAC permissions to
          create sandbox Pods
        end note
    }

    ' ==================== SANDBOX TIER ====================
    package "Sandbox Namespace (Isolated)" as sandbox_ns #LightGreen {
        component "Sandbox\nPod 1" as sandbox1
        component "Sandbox\nPod 2" as sandbox2
        component "Sandbox\nPod N" as sandbox3
        note bottom of sandbox1
          **Isolation:**
          - NetworkPolicy: deny all
          - ResourceQuota: limited
          - SecurityContext: non-root
          - No serviceAccount token
        end note
    }

    ' ==================== QUEUE TIER ====================
    package "Infrastructure Namespace" as infra_ns #LightYellow {
        queue "Redis\n(Task Queue)" as task_queue
        database "Redis\n(State Store)" as redis
    }
}

' ==================== EXTERNAL STORAGE ====================
package "External Storage" as storage_tier #Lavender {
    database "PostgreSQL\n(Task History)" as postgres
    storage "S3/MinIO\n(Large Outputs)" as s3
}

' ==================== MONITORING ====================
package "Observability" as monitoring #LightCoral {
    component "Prometheus" as prometheus
    component "Grafana" as grafana
}

' ==================== RELATIONSHIPS ====================
client --> lb
lb --> api_ns

api1 -[#blue]-> sandbox1 : **K8s API**\n(create Pod)
api2 -[#blue]-> sandbox2 : **K8s API**\n(create Pod)
api3 -[#blue]-> sandbox3 : **K8s API**\n(create Pod)

api_ns --> task_queue : enqueue
api_ns --> redis : read/write state

sandbox_ns -[#red]->x sandbox_ns : **NetworkPolicy**\nNo egress allowed

prometheus --> api_ns : scrape metrics
prometheus --> grafana

api_ns --> postgres : audit log
api_ns --> s3 : large outputs

' ==================== NOTES ====================
note right of lb
  **Why Kubernetes?**
  Avoids Docker-in-Docker problem:
  - No socket mounting
  - No --privileged mode
  - API Pod uses K8s API
  - Industry best practice
end note

note right of k8s
  **Full Containerization**
  All components run as Pods:
  - API: Deployment + HPA
  - Sandbox: Dynamic Pods
  - Redis: StatefulSet
  - No host dependencies
end note

note bottom of sandbox_ns
  **Sandbox Pod Security**
  - securityContext.runAsNonRoot: true
  - securityContext.readOnlyRootFilesystem: true
  - resources.limits: {cpu: 1, memory: 128Mi}
  - automountServiceAccountToken: false
  - NetworkPolicy: deny all ingress/egress
end note

note bottom of api_ns
  **RBAC Permissions**
  API ServiceAccount can only:
  - Create/delete Pods in sandbox-ns
  - Get Pod logs
  - Cannot access other namespaces
end note

@enduml
