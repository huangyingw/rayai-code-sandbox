# Minimal Python sandbox container for secure code execution
FROM python:3.11-slim-bookworm

# Security: Create non-root user
RUN groupadd -r sandbox && useradd -r -g sandbox -d /home/sandbox -s /sbin/nologin sandbox

# Security: Remove unnecessary packages and files
RUN apt-get update && apt-get install -y --no-install-recommends \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/* \
    && rm -rf /usr/share/doc /usr/share/man

# Security: Remove setuid/setgid binaries
RUN find / -perm /6000 -type f -exec chmod a-s {} \; 2>/dev/null || true

# Security: Create read-only workspace
WORKDIR /sandbox
RUN chown sandbox:sandbox /sandbox

# Security: Switch to non-root user
USER sandbox

# Security: Set restrictive environment
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HOME=/home/sandbox

# Default command (will be overridden)
CMD ["python3", "-c", "print('sandbox ready')"]
