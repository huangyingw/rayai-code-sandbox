@startuml improvements
!theme plain
title Code Executor Sandbox - Design Review & Improvements

skinparam componentStyle rectangle
skinparam defaultTextAlignment center
skinparam packageStyle frame

' Layout direction
left to right direction

' ==================== ROW 1: Storage ====================
package "Storage" as pkg_storage {
    rectangle "Current" as cur_storage #LightCoral {
        component "In-Memory\nStorage" as mem_current
    }
    rectangle "Improved" as imp_storage #LightGreen {
        component "Redis/DB\nStorage" as redis_storage
    }
    cur_storage -right-> imp_storage : "Persistence\n& Scalability"
}

' ==================== ROW 2: Task Queue ====================
package "Task Processing" as pkg_queue {
    rectangle "Current" as cur_queue #LightCoral {
        component "BackgroundTasks\n(FastAPI)" as bg_current
    }
    rectangle "Improved" as imp_queue #LightGreen {
        component "Celery/RQ\nQueue" as task_queue
    }
    cur_queue -right-> imp_queue : "Reliability\n& Distribution"
}

' ==================== ROW 3: Authentication ====================
package "Authentication" as pkg_auth {
    rectangle "Current" as cur_auth #LightCoral {
        component "No\nAuthentication" as no_auth
    }
    rectangle "Improved" as imp_auth #LightGreen {
        component "JWT/API Key\nAuth" as auth
    }
    cur_auth -right-> imp_auth : "Access Control\n& Audit"
}

' ==================== ROW 4: Health Check ====================
package "Health Check" as pkg_health {
    rectangle "Current" as cur_health #LightYellow {
        component "Basic\nHealth Check" as basic_health
    }
    rectangle "Improved" as imp_health #LightGreen {
        component "Full Health\nCheck" as full_health
    }
    cur_health -right-> imp_health : "Docker+Queue\nStatus"
}

' ==================== ROW 5: Metrics ====================
package "Observability" as pkg_metrics {
    rectangle "Current" as cur_metrics #LightCoral {
        component "No\nMetrics" as no_metrics
    }
    rectangle "Improved" as imp_metrics #LightGreen {
        component "Prometheus\nMetrics" as metrics
    }
    cur_metrics -right-> imp_metrics : "Monitoring\n& Alerting"
}

' ==================== ROW 6: Container ====================
package "Container Startup" as pkg_container {
    rectangle "Current" as cur_container #LightYellow {
        component "Cold Start\n(~500ms)" as cold_start
    }
    rectangle "Improved" as imp_container #LightGreen {
        component "Container Pool\n(~100ms)" as container_pool
    }
    cur_container -right-> imp_container : "5x Faster\nStartup"
}

' ==================== VERTICAL LAYOUT ====================
pkg_storage -[hidden]down-> pkg_queue
pkg_queue -[hidden]down-> pkg_auth
pkg_auth -[hidden]down-> pkg_health
pkg_health -[hidden]down-> pkg_metrics
pkg_metrics -[hidden]down-> pkg_container

' ==================== LEGEND ====================
legend bottom
  |= Color |= Meaning |
  | <#LightCoral> | High Priority Improvement |
  | <#LightYellow> | Medium Priority Improvement |
  | <#LightGreen> | Suggested Solution |
endlegend

@enduml
