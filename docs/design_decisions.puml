@startuml design_decisions
title Design Decisions

skinparam defaultTextAlignment center
skinparam rectangleBackgroundColor #F8F8F8

' ==================== ROW 1 ====================
rectangle "**Isolation**\nDocker Containers" as r1 #LightBlue {
  note as n1
    Alternatives: gVisor, Firecracker
    Reason: Simple, widely adopted
  end note
}

rectangle "**Security**\nDefense in Depth" as r2 #LightGreen {
  note as n2
    Layer 1: Docker (OS isolation)
    Layer 2: Python sandbox
  end note
}

rectangle "**Module Control**\nWhitelist" as r3 #LightCoral {
  note as n3
    Deny by default
    22 safe modules allowed
  end note
}

' ==================== ROW 2 ====================
rectangle "**Storage**\nIn-Memory" as r4 #LightYellow {
  note as n4
    Zero latency, no dependencies
    Trade-off: lost on restart
  end note
}

rectangle "**Streaming**\nSSE" as r5 #PaleGreen {
  note as n5
    HTTP-based, auto-reconnect
    Simpler than WebSocket
  end note
}

rectangle "**Concurrency**\nasyncio.Semaphore" as r6 #Lavender {
  note as n6
    10 concurrent tasks
    Token bucket rate limit
  end note
}

' ==================== ROW 3 ====================
rectangle "**Full Containerization**\nKubernetes" as r7 #MistyRose {
  note as n7
    Avoids Docker-in-Docker
    No socket sharing
    Industry best practice
  end note
}

' ==================== LAYOUT ====================
r1 -[hidden]right- r2
r2 -[hidden]right- r3
r4 -[hidden]right- r5
r5 -[hidden]right- r6
r1 -[hidden]down- r4
r3 -[hidden]down- r6
r4 -[hidden]down- r7

@enduml
