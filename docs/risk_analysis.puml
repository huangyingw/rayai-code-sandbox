@startuml risk_analysis
title Code Executor Sandbox - Risk Analysis & Mitigations

skinparam componentStyle rectangle
skinparam defaultTextAlignment center

' Legend
legend right
  |= Color |= Severity |
  | <#FF6B6B> | High Risk |
  | <#FFD93D> | Medium Risk |
  | <#6BCB77> | Mitigated |
endlegend

' ==================== SECURITY RISKS ====================
package "Security Risks" as sec_risks {
    component "Container Escape" as escape #6BCB77
    component "Resource Exhaustion\n(Fork Bomb)" as dos #6BCB77
    component "Network Attack" as network #6BCB77
    component "Sandbox Bypass\n(__class__ chain)" as sandbox_bypass #6BCB77
    component "No Authentication" as no_auth #FF6B6B
    component "Insufficient Logging" as no_log #FFD93D
}

' ==================== RELIABILITY RISKS ====================
package "Reliability Risks" as rel_risks {
    component "Task Loss on\nServer Restart" as task_loss #FF6B6B
    component "Single Point\nof Failure" as spof #FF6B6B
    component "No Task Retry" as no_retry #FFD93D
    component "Cold Start\nLatency" as cold_start #FFD93D
    component "Memory Pressure\nUnder Load" as memory #FFD93D
}

' ==================== OPERATIONAL RISKS ====================
package "Operational Risks" as ops_risks {
    component "No Metrics\n/Monitoring" as no_metrics #FFD93D
    component "Manual Scaling" as manual_scale #FFD93D
    component "No Alerting" as no_alert #FFD93D
    component "Docker Daemon\nFailure" as docker_fail #FFD93D
}

' ==================== MITIGATIONS (IMPLEMENTED) ====================
package "Mitigations (Implemented)" as mitigations #LightGreen {
    component "Docker Isolation\n+ --network=none\n+ --cap-drop=ALL\n+ --read-only" as docker_mitigation
    component "Resource Limits\n+ --memory=128m\n+ --pids-limit=50\n+ --cpus=0.5" as resource_mitigation
    component "Python Sandbox\n+ Module Whitelist\n+ Attribute Blocking\n+ Pattern Scanner" as python_mitigation
    component "Concurrency Limit\n(Semaphore)" as concurrency_mitigation
    component "Rate Limiting\n(60 req/min)" as rate_mitigation
}

' ==================== SUGGESTED MITIGATIONS ====================
package "Suggested Mitigations" as suggested #LightBlue {
    component "Add Redis\nfor Persistence" as add_redis
    component "Add Auth\n(JWT/API Key)" as add_auth
    component "Add Prometheus\n+ Grafana" as add_monitoring
    component "Add Celery\nTask Queue" as add_queue
    component "Add Container\nPool" as add_pool
    component "Add Audit\nLogging" as add_audit
}

' ==================== RELATIONSHIPS ====================
escape --> docker_mitigation : mitigated by
dos --> resource_mitigation : mitigated by
network --> docker_mitigation : mitigated by
sandbox_bypass --> python_mitigation : mitigated by

no_auth ..> add_auth : requires
task_loss ..> add_redis : requires
no_metrics ..> add_monitoring : requires
no_retry ..> add_queue : requires
cold_start ..> add_pool : requires
no_log ..> add_audit : requires

memory --> concurrency_mitigation : limited by
memory --> rate_mitigation : limited by

' ==================== PRIORITY NOTES ====================
note right of no_auth
  **HIGH PRIORITY**
  Anyone can execute code
  No usage tracking
  No rate limit per user
end note

note right of task_loss
  **HIGH PRIORITY**
  Tasks lost on restart
  Cannot recover state
  No task history
end note

note bottom of add_redis
  **Implementation:**
  1. Add redis-py
  2. Implement RedisStorage
  3. Store task state + output
  4. Add TTL for cleanup
end note

note bottom of add_auth
  **Implementation:**
  1. Add API key header
  2. Store keys in DB/Vault
  3. Per-key rate limits
  4. Key rotation support
end note

@enduml
