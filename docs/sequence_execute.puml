@startuml sequence_execute
!theme plain
title Code Execution Flow (Docker Required)
skinparam responseMessageBelowArrow true
skinparam noteBackgroundColor #FFFFCC
skinparam noteBorderColor #999999

actor "Client" as Client
participant "RateLimiter" as RateLimiter
participant "FastAPI" as API
participant "SandboxExecutor" as Executor
participant "DockerRunner" as Docker
participant "TaskStorage" as Store
participant "Container" as Container

== Phase 1: Rate Limiting ==

Client -> RateLimiter : HTTP Request

alt Rate Limit Exceeded
    RateLimiter --> Client : 429 Too Many Requests
else Rate OK
    RateLimiter --> API : Forward
end

== Phase 2: Submit Code ==

Client -> API : POST /execute

note right of API
  Pydantic validation:
  code: str (1-100KB)
end note

API -> Executor : create_task(code)
Executor -> Store : create(Task)
Store --> Executor : Task

API -> Executor : execute(task_id)
API --> Client : {"task_id": "abc123"}

note right of Client
  Async response.
  Use GET /tasks/{id}
  or SSE to track.
end note

== Phase 3: Acquire Semaphore ==

Executor -> Executor : await semaphore.acquire()

note right of Executor
  Max 10 concurrent tasks.
  Wait or fail if full.
end note

== Phase 4: Code Validation ==

Executor -> Store : update(status=RUNNING)
Executor -> Executor : _validate_code(code)

note right of Executor
  1. Empty check
  2. UTF-8 encoding
  3. Syntax (compile)
  4. Pattern scan
end note

alt Validation Failed
    Executor -> Store : update(status=FAILED)
else OK
end

== Phase 5: Generate Docker Wrapper ==

Executor -> Executor : generate_docker_wrapper()

note right of Executor
  Wrapper includes:
  - Resource limits
  - Restricted builtins
  - Module whitelist
  - Attribute blocking
end note

== Phase 6: Docker Execution ==

Executor -> Docker : build_docker_command()

note right of Docker
  docker run --rm
  --network=none
  --read-only
  --cap-drop=ALL
  --memory=128m
  --pids-limit=50
  --user=nobody
  --security-opt seccomp=...
end note

Docker -> Container : docker run
activate Container

Container --> Executor : stdout/stderr (streaming)
Executor -> Store : append_output()

Container --> Docker : exit code
deactivate Container

== Phase 7: Process Result ==

alt exit_code == 0
    Executor -> Store : status=COMPLETED
else exit_code == 137
    Executor -> Store : status=TIMEOUT
else exit_code != 0
    Executor -> Store : status=FAILED
end

== Phase 8: Cleanup ==

Executor -> Docker : cleanup_task()
Executor -> Executor : semaphore.release()
Executor -> Store : update(finished_at)

== Phase 9: Query Result ==

Client -> API : GET /tasks/{task_id}
API -> Store : get(task_id)
Store --> API : Task
API --> Client : TaskResponse JSON

note right of Client
  {"task_id": "abc123",
   "status": "completed",
   "stdout": "...",
   "exit_code": 0}
end note

@enduml
