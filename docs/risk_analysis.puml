@startuml risk_analysis
title Code Executor Sandbox - Risk Analysis & Mitigations

skinparam componentStyle rectangle
skinparam defaultTextAlignment center
skinparam packageStyle frame

' ==================== LEGEND ====================
legend top
  |= Color |= Status |
  | <#6BCB77> | ✓ Mitigated |
  | <#FFD93D> | △ Medium Risk |
  | <#FF6B6B> | ✗ High Risk |
endlegend

' ==================== SECTION 1: MITIGATED RISKS ====================
package "Mitigated Security Risks" as mitigated_pkg #EEFFEE {

    rectangle "Container Escape" as r1 #6BCB77 {
    }
    rectangle "Resource Exhaustion\nFork Bomb/DoS" as r2 #6BCB77 {
    }
    rectangle "Network Attack" as r3 #6BCB77 {
    }
    rectangle "Sandbox Bypass\n__class__ chain" as r4 #6BCB77 {
    }

    note bottom of r1
      **Mitigations:**
      Docker --cap-drop=ALL
      --security-opt=no-new-privileges
    end note

    note bottom of r2
      **Mitigations:**
      --memory=128m
      --pids-limit=50
      --cpus=0.5
    end note

    note bottom of r3
      **Mitigations:**
      --network=none
      Complete network isolation
    end note

    note bottom of r4
      **Mitigations:**
      Module whitelist
      Attribute blocklist
      Pattern scanner
    end note
}

' ==================== SECTION 2: HIGH RISKS ====================
package "High Priority Risks" as high_pkg #FFEEEE {

    rectangle "No Authentication" as h1 #FF6B6B {
    }
    rectangle "Task Loss" as h2 #FF6B6B {
    }
    rectangle "Single Point\nof Failure" as h3 #FF6B6B {
    }

    note bottom of h1
      **Issue:** Anyone can execute code
      **Suggestion:** Add JWT/API Key
    end note

    note bottom of h2
      **Issue:** Tasks lost on restart
      **Suggestion:** Add Redis persistence
    end note

    note bottom of h3
      **Issue:** Single instance, no scaling
      **Suggestion:** Add load balancer
    end note
}

' ==================== SECTION 3: MEDIUM RISKS ====================
package "Medium Priority Risks" as medium_pkg #FFFFEE {

    rectangle "No Metrics" as m1 #FFD93D {
    }
    rectangle "No Retry" as m2 #FFD93D {
    }
    rectangle "Cold Start" as m3 #FFD93D {
    }
    rectangle "Insufficient\nLogging" as m4 #FFD93D {
    }

    note bottom of m1
      **Suggestion:** Prometheus + Grafana
    end note

    note bottom of m2
      **Suggestion:** Celery task queue
    end note

    note bottom of m3
      **Suggestion:** Container pool warmup
    end note

    note bottom of m4
      **Suggestion:** Audit logging
    end note
}

' ==================== LAYOUT ====================
mitigated_pkg -[hidden]down-> high_pkg
high_pkg -[hidden]down-> medium_pkg

@enduml
