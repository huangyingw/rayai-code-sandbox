@startuml platform_comparison
title Ray vs Modal vs Fly.io - Platform Comparison

skinparam componentStyle rectangle
skinparam defaultTextAlignment center
top to bottom direction

' ==================== COMPARISON TABLE (TOP) ====================
package "Feature Comparison" as comparison #Wheat {
    note as compTable
      | Feature | Ray | Modal | Fly.io |
      |---------|-----|-------|--------|
      | **Primary Use** | Distributed ML | Serverless AI | Edge/GPU Apps |
      | **Isolation** | Process | gVisor | Firecracker |
      | **GPU Support** | Excellent | Strong | A10/L40S/A100 |
      | **GPU Autoscale** | Yes (V2) | Yes | Scale-to-zero |
      | **Cold Start** | N/A (cluster) | <1s | <1s |
      | **Scaling** | 1000s GPUs | 10K+ sandboxes | Global edge |
      | **Statefulness** | Actors | Volumes | Persistent VM |
      | **Pricing** | Self-host/Anyscale | Per-execution | Per-second |
      | **Best For** | ML Training | Code Sandbox | GPU Inference |
    end note
}

' ==================== RAY ====================
package "Ray (Anyscale)" as ray #LightBlue {
    component "Distributed Compute Engine" as rayCore

    package "Use Cases" as rayUse {
        component "ML Training (OpenAI ChatGPT)" as rayTrain #SkyBlue
        component "RL Agents (Stateful Actors)" as rayRL #SkyBlue
        component "Hyperparameter Search" as rayHyper #SkyBlue
    }

    package "Architecture" as rayArch {
        component "Ray Core (Tasks + Actors)" as rayTasks
        component "Ray Serve (Model Serving)" as rayServe
        component "Object Store (Shared Memory)" as rayObj
    }

    note bottom of ray
      **Strengths**
      + Sub-ms task scheduling
      + Millions tasks/sec
      + Multi-GPU autoscaling
      + Stateful actors
      + OpenAI uses it

      **Weaknesses**
      - Self-managed complexity
      - Learning curve
    end note
}

' ==================== MODAL ====================
package "Modal" as modal #LightGreen {
    component "Serverless GPU Platform" as modalCore

    package "Use Cases" as modalUse {
        component "AI Code Sandboxes" as modalSandbox #PaleGreen
        component "Batch Jobs" as modalBatch #PaleGreen
        component "Model Inference" as modalInfer #PaleGreen
    }

    package "Architecture" as modalArch {
        component "Container Orchestration" as modalContainer
        component "gVisor Isolation" as modalGvisor
        component "Snapshot Volumes" as modalSnap
    }

    note bottom of modal
      **Strengths**
      + Zero config serverless
      + Sub-second cold start
      + 10K+ concurrent sandboxes
      + Built-in tunneling
      + Python-native SDK

      **Weaknesses**
      - No on-prem option
      - Vendor lock-in
    end note
}

' ==================== FLY.IO ====================
package "Fly.io" as flyio #LightCoral {
    component "Edge Micro-VMs" as flyCore

    package "Use Cases" as flyUse {
        component "GPU Inference (A10/L40S/A100)" as flyGPU #LightPink
        component "Global Edge Deployment" as flyEdge #LightPink
        component "Scale-to-Zero Workloads" as flyVM #LightPink
    }

    package "Architecture" as flyArch {
        component "Firecracker Micro-VMs" as flyFirecracker
        component "REST API (Machines)" as flyAPI
        component "Global Regions" as flyRegions
    }

    note bottom of flyio
      **Strengths**
      + <1s VM spin-up
      + Global edge network
      + Simple CLI
      + GPU: A10/L40S/A100
      + Scale to zero

      **Weaknesses**
      - Limited GPU regions
      - No AI-specific features
      - Manual sandbox setup
    end note
}

' ==================== DECISION FLOWCHART ====================
package "When to Use What?" as decision #Lavender {
    note as decisionNote
      **Choose Ray when:**
      * Training large ML models
      * Need stateful RL agents
      * Multi-GPU/multi-node required

      **Choose Modal when:**
      * Running untrusted code
      * Serverless GPU inference
      * Quick prototyping

      **Choose Fly.io when:**
      * Simple GPU inference
      * Global low-latency needed
      * Scale-to-zero GPU workloads
    end note
}

' Force vertical layout
comparison -[hidden]down-> ray
ray -[hidden]down-> modal
modal -[hidden]down-> flyio
flyio -[hidden]down-> decision

@enduml
