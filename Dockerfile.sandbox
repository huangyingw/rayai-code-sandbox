# Minimal Python sandbox container for secure code execution
# Built with security hardening for untrusted code execution
FROM python:3.11-slim-bookworm

# Security: Create non-root user with no shell
RUN groupadd -r sandbox && useradd -r -g sandbox -d /home/sandbox -s /usr/sbin/nologin sandbox

# Security: Remove unnecessary packages, pip, and files
RUN apt-get update \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/* \
    && rm -rf /usr/share/doc /usr/share/man \
    # Remove pip to prevent package installation
    && rm -rf /usr/local/lib/python*/dist-packages/pip* \
    && rm -rf /usr/local/lib/python*/ensurepip \
    && rm -f /usr/local/bin/pip* \
    # Remove other potentially dangerous tools
    && rm -rf /usr/local/lib/python*/dist-packages/setuptools* \
    && rm -rf /usr/local/lib/python*/dist-packages/wheel* \
    # Remove compilers and development tools if present
    && apt-get purge -y --auto-remove gcc g++ make 2>/dev/null || true

# Security: Remove setuid/setgid binaries
RUN find / -perm /6000 -type f -exec chmod a-s {} \; 2>/dev/null || true

# Security: Remove shells (except for sh which Python may need)
RUN rm -f /bin/bash /bin/dash /bin/zsh 2>/dev/null || true

# Security: Create read-only workspace
WORKDIR /sandbox
RUN mkdir -p /home/sandbox && chown -R sandbox:sandbox /sandbox /home/sandbox

# Security: Switch to non-root user
USER sandbox

# Security: Set restrictive environment
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONHASHSEED=random \
    HOME=/home/sandbox \
    # Prevent Python from looking for user site-packages
    PYTHONNOUSERSITE=1

# Health check - verify sandbox is functional
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=1 \
    CMD python3 -c "print('ok')" || exit 1

# Default command (will be overridden)
CMD ["python3", "-c", "print('sandbox ready')"]
