@startuml risk_analysis
title Code Executor Sandbox - Risk Analysis & Mitigations

skinparam defaultTextAlignment center
skinparam rectangleBorderThickness 2
skinparam noteFontSize 10
skinparam wrapWidth 120

' Force left-to-right layout
left to right direction

' ==================== LEGEND ====================
legend top
  |= Color |= Priority |= Status |
  | <#6BCB77> | - | ✓ Mitigated |
  | <#FFD93D> | Medium | △ Needs Work |
  | <#FF6B6B> | High | ✗ Not Addressed |
endlegend

' ==================== MITIGATED RISKS (GREEN) ====================
package "MITIGATED" as pkg_mitigated #EEFFEE {
    rectangle "Container Escape\n<size:9>--cap-drop=ALL</size>" as r1 #6BCB77
    rectangle "Resource Exhaustion\n<size:9>--memory=128m</size>" as r2 #6BCB77
    rectangle "Network Attack\n<size:9>--network=none</size>" as r3 #6BCB77
    rectangle "Sandbox Bypass\n<size:9>Module whitelist</size>" as r4 #6BCB77
}

' ==================== HIGH RISKS (RED) ====================
package "HIGH RISK" as pkg_high #FFEEEE {
    rectangle "No Authentication\n<size:9>→ Add JWT/API Key</size>" as h1 #FF6B6B
    rectangle "Task Loss on Restart\n<size:9>→ Add Redis</size>" as h2 #FF6B6B
    rectangle "Single Point of Failure\n<size:9>→ Add Load Balancer</size>" as h3 #FF6B6B
}

' ==================== MEDIUM RISKS (YELLOW) ====================
package "MEDIUM RISK" as pkg_medium #FFFFEE {
    rectangle "No Metrics\n<size:9>→ Prometheus</size>" as m1 #FFD93D
    rectangle "No Retry\n<size:9>→ Celery Queue</size>" as m2 #FFD93D
    rectangle "Cold Start\n<size:9>→ Container Pool</size>" as m3 #FFD93D
    rectangle "Insufficient Logging\n<size:9>→ Audit Log</size>" as m4 #FFD93D
}

' ==================== LAYOUT ====================
pkg_mitigated -[hidden]right-> pkg_high
pkg_high -[hidden]right-> pkg_medium

@enduml
